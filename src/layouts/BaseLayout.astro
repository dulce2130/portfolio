---
import '../styles/global.css';
import Header from '../components/Header.astro';
import BackgroundAtmosphere from '../components/BackgroundAtmosphere.astro';
import { getLocale, getUI, localizedPath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  theme?: 'light' | 'dark';
}

const locale = getLocale(Astro.currentLocale);
const t = getUI(locale);
const { title = t.title, description = t.description, theme } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const alternate = (lang: 'es' | 'en') => {
  const path = localizedPath(Astro.url.pathname, lang);
  return Astro.site ? new URL(path, Astro.site) : path;
};
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before first paint; without a saved choice, CSS follows the OS.
      try {
        const theme = localStorage.getItem('portfolio-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch { /* System preference remains available without storage. */ }
      document.documentElement.dataset.themeResolved = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="es" href={alternate('es')} />
    <link rel="alternate" hreflang="en" href={alternate('en')} />
    <link rel="alternate" hreflang="x-default" href={alternate('es')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.socialLocale} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_MX'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <BackgroundAtmosphere />
    <a class="skip-link" href="#contenido">{t.skip}</a>
    <Header />
    <main id="contenido" class="container" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<script>
  import '../scripts/motion-visibility';
</script>
