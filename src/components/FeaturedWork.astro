---
import { projects } from '../data/projects';
import { getLocale, getUI } from '../i18n/utils';
import ProjectPreview from './ProjectPreview.astro';
const locale = getLocale(Astro.currentLocale);
const t = getUI(locale);
---

<section id="work" class="featured-work" aria-labelledby="work-title" data-featured-work>
  <div class="work-pin" data-work-pin>
    <canvas class="work-field" data-work-field aria-hidden="true"></canvas>
    <canvas class="work-spiral" data-work-spiral aria-hidden="true" hidden></canvas>
    <header class="work-intro">
      <div><p class="metadata">{t.workEyebrow}</p><h2 id="work-title">{t.workTitle}</h2></div>
      <p class="work-index metadata" aria-hidden="true"><span data-work-current>01</span> / {String(projects.length).padStart(2, '0')}</p>
    </header>
    <div class="work-stage" data-work-stage>
      <ol class="work-list" role="list">{projects.map((project, index) => <ProjectPreview project={project} locale={locale} index={index} />)}</ol>
    </div>
    <div class="work-controls" role="group" aria-label={t.workControls} data-work-controls hidden>
      <p class="metadata work-hint">{t.workHint}<span aria-hidden="true"> ↓</span></p>
      <div><button type="button" data-work-step="-1" aria-label={t.workPrevious}>←</button><button type="button" data-work-step="1" aria-label={t.workNext}>→</button></div>
      <span class="sr-only" role="status" data-work-status></span>
    </div>
  </div>
  <div class="work-scroll-room" aria-hidden="true"></div>

</section>

<script>
  import '../scripts/featured-work';
</script>

<style is:global>
  @property --work-rim-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
</style>
<style>
  .featured-work { position: relative; margin-block-start: var(--space-24); border-block-start: var(--border-subtle); scroll-margin-block-start: var(--space-4); }
  .featured-work:not([data-deck]) :global([data-project]) { transform: none !important; opacity: 1 !important; transition: none !important; }
  .work-pin { position: relative; isolation: isolate; padding-block: var(--space-12); }
  .work-intro { display: flex; align-items: end; justify-content: space-between; gap: var(--space-6); position: relative; z-index: 2; }
  .work-intro .metadata { margin: 0 0 var(--space-4); text-transform: uppercase; }
  h2 { margin: 0; font-family: var(--font-display); font-weight: var(--weight-normal); font-size: clamp(2.25rem, 4vw, 4rem); letter-spacing: var(--tracking-display); line-height: 1.08; }
  .work-index { white-space: nowrap; }
  .work-list { list-style: none; margin: 0; padding: var(--space-16) 0 0; display: flex; flex-direction: column; gap: var(--space-16); }
  .work-field { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; z-index: -1; pointer-events: none; opacity: .8; }
  .work-spiral { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; z-index: 0; pointer-events: none; }
  .work-scroll-room { display: none; }
  .work-controls { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); position: relative; z-index: 2; }
  .work-controls > div { display: flex; gap: var(--space-3); }
  button { min-block-size: var(--target-min); min-inline-size: var(--target-min); border: var(--border-subtle); border-radius: var(--radius-pill); background: var(--color-surface); color: var(--color-text); cursor: pointer; }
  button:hover { border-color: var(--color-link); color: var(--color-link); }
  button:disabled { opacity: .35; cursor: default; }
  .work-hint { margin: 0; font-size: .6875rem; text-transform: uppercase; }
  [data-deck] .work-scroll-room { display: block; block-size: 320svh; }
  [data-deck] .work-pin { position: sticky; inset-block-start: 0; min-block-size: 100svh; block-size: 100svh; display: flex; flex-direction: column; padding-block: clamp(1.5rem, 4svh, 3rem); overflow: clip; background: color-mix(in srgb, var(--color-bg) 92%, transparent); }
  [data-deck] .work-intro { padding-inline: var(--space-4); z-index: 5; }
  [data-deck] h2 { font-size: clamp(2rem, 3.5vw, 3.25rem); }
  [data-deck] .work-intro .metadata { margin-block-end: var(--space-2); }
  [data-deck] .work-stage { position: relative; z-index: 2; flex: 1; min-block-size: 0; pointer-events: none; }
  [data-deck] .work-list { display: block; padding: 0; position: absolute; inset: 0; }
  [data-deck] .work-controls { padding-inline: var(--space-4); }
  [data-mobile] .work-list { flex-direction: row; gap: var(--space-5); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--space-2); padding-inline: var(--space-2); scrollbar-width: thin; overscroll-behavior-inline: contain; }
  [data-mobile] .work-stage { min-inline-size: 0; }
  @media (prefers-reduced-motion: no-preference) {
    [data-deck] .work-intro p, [data-deck] .work-intro h2 { transition: opacity 360ms var(--ease-out), transform 480ms var(--ease-out); }
    [data-deck] .work-intro h2 { transition-delay: 80ms; }
    [data-deck]:not([data-work-entered]) .work-intro p,
    [data-deck]:not([data-work-entered]) .work-intro h2 { opacity: 0; transform: translateY(10px); }
  }
  @media (max-width: 47.999rem) { .work-pin { padding-block: var(--space-8); } .work-list { padding-block-start: var(--space-12); gap: var(--space-12); } .work-index { display: none; } }
</style>
