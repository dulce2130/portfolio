const t = content[locale];
---

<section
    id="contact"
    class="contact-section grid-12"
    aria-labelledby="contact-title"
>
    <header class="contact-intro">
        <p class="metadata">{t.eyebrow}</p>

        <div class="contact-intro__content">
            <h2 id="contact-title">
                <span>{t.title}</span>
                <em>{t.accent}</em>
            </h2>

            <p>{t.intro}</p>
        </div>
    </header>

    <div class="contact-frame">
        <div class="contact-atmosphere" aria-hidden="true">
            <svg viewBox="0 0 1200 760" preserveAspectRatio="none">
                <ellipse
                    class="contact-orbit contact-orbit--one"
                    cx="710"
                    cy="380"
                    rx="490"
                    ry="220"
                    transform="rotate(-11 710 380)"></ellipse>

                <ellipse
                    class="contact-orbit contact-orbit--two"
                    cx="870"
                    cy="310"
                    rx="280"
                    ry="350"
                    transform="rotate(14 870 310)"></ellipse>

                <g class="contact-stars">
                    <circle cx="120" cy="180" r="2"></circle>
                    <circle cx="290" cy="620" r="2.5"></circle>
                    <circle cx="530" cy="145" r="2"></circle>
                    <circle cx="790" cy="570" r="3"></circle>
                    <circle cx="990" cy="180" r="2.5"></circle>
                    <circle cx="1100" cy="510" r="2"></circle>
                </g>
            </svg>
        </div>

        <div class="contact-frame__header">
            <span class="metadata">{t.frameLabel}</span>

            <span class="contact-frame__status">
                <i aria-hidden="true"></i>
                {t.availability}
            </span>
        </div>

        <div class="contact-form-panel">
            <div class="contact-form-panel__intro">
                <span class="contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M4 5h16v11H8l-4 4V5Z"></path>
                        <path d="M8 9h8M8 12h5"></path>
                    </svg>
                </span>

                <div>
                    <h3>{t.form.heading}</h3>
                    <p>{t.form.description}</p>
                </div>
            </div>

            <form
                class="contact-form"
                action="https://api.web3forms.com/submit"
                method="POST"
                data-contact-form
                data-sending={t.form.sending}
                data-success={t.form.success}
                data-error={t.form.error}
                data-whatsapp-invalid={t.form.whatsappInvalid}
            >
                <input type="hidden" name="access_key" value={web3formsKey} />
                <input
                    type="hidden"
                    name="subject"
                    value="Nuevo mensaje desde el portafolio de Dulce González"
                />
                <input
                    type="hidden"
                    name="from_name"
                    value="Portafolio — Dulce González"
                />

                <input
                    type="checkbox"
                    name="botcheck"
                    class="contact-botcheck"
                    tabindex="-1"
                    autocomplete="off"
                />

                <div class="form-field">
                    <label for={`contact-name-${locale}`}>
                        {t.form.name}<span aria-hidden="true">*</span>
                    </label>

                    <input
                        id={`contact-name-${locale}`}
                        name="name"
                        type="text"
                        autocomplete="name"
                        placeholder={t.form.namePlaceholder}
                        required
                    />
                </div>

                <div class="form-field">
                    <label for={`contact-email-${locale}`}>
                        {t.form.email}<span aria-hidden="true">*</span>
                    </label>

                    <input
                        id={`contact-email-${locale}`}
                        name="email"
                        type="email"
                        autocomplete="email"
                        placeholder={t.form.emailPlaceholder}
                        required
                    />
                </div>

                <div class="form-field form-field--wide">
                    <label for={`contact-type-${locale}`}>{t.form.type}</label>

                    <div class="form-select">
                        <select
                            id={`contact-type-${locale}`}
                            name="project_type"
                        >
                            <option value="">{t.form.typePlaceholder}</option>

                            {
                                t.form.options.map((option) => (
                                    <option value={option}>{option}</option>
                                ))
                            }
                        </select>

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m7 9 5 5 5-5"></path>
                        </svg>
                    </div>
                </div>

                <div class="form-field form-field--wide">
                    <label for={`contact-message-${locale}`}>
                        {t.form.message}<span aria-hidden="true">*</span>
                    </label>

                    <textarea
                        id={`contact-message-${locale}`}
                        name="message"
                        rows="6"
                        placeholder={t.form.messagePlaceholder}
                        required></textarea>
                </div>

                <fieldset class="contact-preference form-field--wide">
                    <legend>{t.form.preference}</legend>

                    <div class="contact-preference__options">
                        <label class="contact-choice">
                            <input
                                type="radio"
                                name="preferred_contact"
                                value="email"
                                checked
                            />
                            <span class="contact-choice__indicator"></span>
                            <span>{t.form.emailOption}</span>
                        </label>

                        <label class="contact-choice">
                            <input
                                type="radio"
                                name="preferred_contact"
                                value="whatsapp"
                            />
                            <span class="contact-choice__indicator"></span>
                            <span>{t.form.whatsappOption}</span>
                        </label>
                    </div>
                </fieldset>

                <div
                    class="form-field form-field--wide form-field--whatsapp"
                    data-whatsapp-field
                    hidden
                >
                    <label for={`contact-whatsapp-${locale}`}>
                        {t.form.whatsapp}<span aria-hidden="true">*</span>
                    </label>

                    <input
                        id={`contact-whatsapp-${locale}`}
                        name="whatsapp"
                        type="tel"
                        autocomplete="tel"
                        inputmode="tel"
                        placeholder={t.form.whatsappPlaceholder}
                        minlength="8"
                        maxlength="20"
                        pattern="^\+?[0-9\s().-]{8,20}$"
                        data-whatsapp-input
                        aria-describedby={`contact-whatsapp-help-${locale} contact-whatsapp-feedback-${locale}`}
                    />
                    <small
                        id={`contact-whatsapp-feedback-${locale}`}
                        class="whatsapp-input-feedback"
                        data-whatsapp-feedback
                        role="status"
                        aria-live="polite"
                        hidden
                    >
                        {
                            locale === "es"
                                ? "Usa sólo números. Puedes incluir +, espacios o guiones."
                                : "Use numbers only. You may include +, spaces or hyphens."
                        }
                    </small>
                    <small id={`contact-whatsapp-help-${locale}`}>
                        {t.form.whatsappHelp}
                    </small>
                </div>

                <div class="contact-form__footer form-field--wide">
                    <button class="contact-submit" type="submit">
                        <span data-submit-label>{t.form.submit}</span>

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14M14 7l5 5-5 5"></path>
                        </svg>
                    </button>

                    <p
                        class="contact-form__status"
                        data-form-status
                        aria-live="polite"
                    >
                    </p>
                </div>
            </form>
        </div>

        <aside class="contact-call-panel">
            <div class="contact-call-visual" aria-hidden="true">
                <span class="call-orbit call-orbit--outer"></span>
                <span class="call-orbit call-orbit--inner"></span>

                <span class="call-node call-node--one"></span>
                <span class="call-node call-node--two"></span>
                <span class="call-node call-node--three"></span>

                <div class="call-core">
                    <span></span>
                </div>
            </div>

            <div class="contact-call-copy">
                <p class="metadata">{t.call.eyebrow}</p>

                <h3>
                    <span>{t.call.title}</span>
                    <em>{t.call.accent}</em>
                </h3>

                <p class="contact-call-copy__description">
                    {t.call.description}
                </p>

                <div class="contact-call-meta">
                    <div>
                        <span class="contact-call-meta__icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 6h11v12H4z"></path>
                                <path d="m15 10 5-3v10l-5-3z"></path>
                            </svg>
                        </span>
                        <span>{t.call.meet}</span>
                    </div>

                    <div>
                        <span class="contact-call-meta__dot"></span>
                        <span>{t.call.remote}</span>
                    </div>

                    <div>
                        <span class="contact-call-meta__dot"></span>
                        <span>{t.call.camera}</span>
                    </div>
                </div>

                <div class="contact-call-note">
                    <span aria-hidden="true">✦</span>
                    <p>{t.call.note}</p>
                </div>

                <a
                    class="contact-call-button"
                    href={calendarUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${t.call.button} — Google Meet`}
                >
                    <span class="contact-call-button__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect
                                x="3.5"
                                y="5.5"
                                width="17"
                                height="15"
                                rx="2.5"></rect>
                            <path d="M7 3.5v4M17 3.5v4M3.5 9.5h17"></path>
                            <path d="m8.2 14.7 2.2 2.2 5.4-5.4"></path>
                        </svg>
                    </span>

                    <span class="contact-call-button__copy">
                        <strong>{t.call.button}</strong>
                        <small>Google Meet · 20 min</small>
                    </span>

                    <span class="contact-call-button__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M7 17 17 7M9 7h8v8"></path>
                        </svg>
                    </span>
                </a>

                <p class="contact-call-footer">{t.call.footer}</p>
            </div>
        </aside>
    </div>
</section>

<script>
    const forms = document.querySelectorAll<HTMLFormElement>(
        "[data-contact-form]",
    );

    forms.forEach((form) => {
        if (form.dataset.contactInitialized === "true") return;
        form.dataset.contactInitialized = "true";

        const submitButton = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
        );
        const submitLabel = form.querySelector<HTMLElement>(
            "[data-submit-label]",
        );
        const status = form.querySelector<HTMLElement>("[data-form-status]");
        const whatsappField = form.querySelector<HTMLElement>(
            "[data-whatsapp-field]",
        );
        const whatsappInput = form.querySelector<HTMLInputElement>(
            "[data-whatsapp-input]",
        );
        const whatsappFeedback = form.querySelector<HTMLElement>(
            "[data-whatsapp-feedback]",
        );
        const preferenceInputs = form.querySelectorAll<HTMLInputElement>(
            'input[name="preferred_contact"]',
        );

        const whatsappInvalid =
            form.dataset.whatsappInvalid ?? "Enter a valid WhatsApp number.";

        function wantsWhatsapp(): boolean {
            const selected = form.querySelector<HTMLInputElement>(
                'input[name="preferred_contact"]:checked',
            );

            return selected?.value === "whatsapp";
        }

        function clearWhatsappError(): void {
            whatsappInput?.setCustomValidity("");
        }

        function syncPreference(): void {
            const showWhatsapp = wantsWhatsapp();

            if (whatsappField) {
                whatsappField.hidden = !showWhatsapp;
            }

            if (whatsappInput) {
                whatsappInput.required = showWhatsapp;

                if (!showWhatsapp) {
                    whatsappInput.value = "";
                    whatsappInput.setCustomValidity("");
                }
            }
        }

        function validateWhatsapp(): boolean {
            if (!wantsWhatsapp() || !whatsappInput) return true;

            const value = whatsappInput.value.trim();
            const validCharacters = /^\+?[0-9\s().-]+$/.test(value);
            const digitCount = value.replace(/\D/g, "").length;
            const validLength = digitCount >= 8 && digitCount <= 15;

            if (!validCharacters || !validLength) {
                whatsappInput.setCustomValidity(whatsappInvalid);
                whatsappInput.reportValidity();
                whatsappInput.focus();
                return false;
            }

            whatsappInput.setCustomValidity("");
            return true;
        }

        preferenceInputs.forEach((input) => {
            input.addEventListener("change", syncPreference);
        });

        // Evitar letras y caracteres no permitidos mientras escribe
        whatsappInput?.addEventListener("input", () => {
            if (!whatsappInput) return;

            const originalValue = whatsappInput.value;

            // Eliminar caracteres no permitidos
            let value = originalValue.replace(/[^0-9+\s().-]/g, "");

            // Permitir + solamente al inicio
            value = value.replace(/(?!^)\+/g, "");

            // Máximo 15 dígitos reales
            let digitCount = 0;

            value = [...value]
                .filter((character) => {
                    if (/\d/.test(character)) {
                        digitCount++;
                        return digitCount <= 15;
                    }

                    return true;
                })
                .join("");

            const wasCorrected = originalValue !== value;

            whatsappInput.value = value;

            clearWhatsappError();

            // Mostrar ayuda sólo si hubo caracteres rechazados
            if (whatsappFeedback) {
                whatsappFeedback.hidden = !wasCorrected;
            }
        });

        syncPreference();

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!validateWhatsapp()) return;

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            if (!submitButton || !submitLabel || !status) {
                form.submit();
                return;
            }

            const defaultLabel = submitLabel.textContent ?? "";
            const sending = form.dataset.sending ?? "Sending…";
            const success = form.dataset.success ?? "Message sent.";
            const errorMessage = form.dataset.error ?? "Something went wrong.";

            submitButton.disabled = true;
            submitLabel.textContent = sending;
            status.textContent = "";
            status.removeAttribute("data-state");

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error("Form submission failed.");
                }

                status.textContent = success;
                status.dataset.state = "success";

                form.reset();
                syncPreference();
            } catch {
                status.textContent = errorMessage;
                status.dataset.state = "error";
            } finally {
                submitButton.disabled = false;
                submitLabel.textContent = defaultLabel;
            }
        });
    });
</script>

<style>
    .contact-section {
        position: relative;
        padding-block: clamp(6rem, 10vw, 10rem);
        scroll-margin-block-start: var(--header-clearance, 7rem);
        content-visibility: auto;
        contain-intrinsic-size: auto 1000px;
    }

    .contact-intro {
        grid-column: 2 / 12;
        display: grid;
        grid-template-columns: minmax(8rem, 0.3fr) minmax(0, 1fr);
        gap: clamp(2rem, 5vw, 5rem);
        align-items: start;
        margin-block-end: clamp(2.5rem, 5vw, 4.5rem);
    }

    .contact-intro > .metadata {
        margin: 0;
        color: var(--color-text-muted);
    }

    .contact-intro h2 {
        display: flex;
        flex-direction: column;
        max-inline-size: 14ch;
        margin: 0;
        color: var(--color-text);
        font-size: clamp(3rem, 5vw, 5.7rem);
        font-weight: var(--weight-medium);
        line-height: 0.94;
        letter-spacing: -0.055em;
    }

    .contact-intro h2 em {
        color: var(--color-link);
        font-family: var(--font-display);
        font-weight: var(--weight-normal);
        font-style: italic;
    }

    .contact-intro__content > p {
        max-inline-size: 52ch;
        margin: 1.6rem 0 0;
        color: var(--color-text-muted);
        font-size: clamp(1rem, 1.25vw, 1.13rem);
        line-height: 1.75;
    }

    .contact-frame {
        grid-column: 2 / 12;
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
        overflow: hidden;
        isolation: isolate;
        border: 1px solid color-mix(in srgb, var(--color-link) 19%, transparent);
        border-radius: clamp(1rem, 2vw, 1.5rem);
        background:
            radial-gradient(
                circle at 76% 32%,
                rgb(169 154 255 / 0.15),
                transparent 28%
            ),
            radial-gradient(
                circle at 94% 82%,
                rgb(239 173 217 / 0.1),
                transparent 26%
            ),
            color-mix(in srgb, var(--color-surface) 97%, var(--color-bg));
        box-shadow: 0 2rem 6rem
            color-mix(in srgb, var(--color-bg) 28%, transparent);
        contain: layout paint style;
    }

    .contact-frame__header {
        grid-column: 1 / -1;
        position: relative;
        z-index: 3;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.35rem;
        border-block-end: var(--border-subtle);
        background: color-mix(in srgb, var(--color-surface) 94%, transparent);
        color: var(--color-text-muted);
    }

    .contact-frame__status {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        overflow-wrap: anywhere;
    }

    .contact-frame__status i {
        flex: none;
        inline-size: 0.45rem;
        block-size: 0.45rem;
        border-radius: 50%;
        background: #a99aff;
        box-shadow: 0 0 0.65rem rgb(169 154 255 / 0.55);
    }

    .contact-atmosphere {
        position: absolute;
        z-index: 0;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .contact-atmosphere svg {
        inline-size: 100%;
        block-size: 100%;
        color: var(--color-link);
        opacity: 0.19;
    }

    .contact-orbit {
        fill: none;
        stroke: currentColor;
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }

    .contact-orbit--one {
        stroke-dasharray: 9 15;
    }
    .contact-orbit--two {
        stroke-dasharray: 2 14;
        opacity: 0.65;
    }
    .contact-stars {
        fill: currentColor;
    }

    .contact-form-panel {
        position: relative;
        z-index: 2;
        padding: clamp(1.5rem, 3vw, 2.6rem);
        border-inline-end: var(--border-subtle);
    }

    .contact-form-panel__intro {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 1rem;
        margin-block-end: 2.2rem;
    }

    .contact-icon {
        inline-size: 2.7rem;
        block-size: 2.7rem;
        display: grid;
