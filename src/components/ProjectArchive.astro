    listLabel: 'Professional project archive',

    noteTitle: 'About these projects',

    note:
      'These projects were completed as part of my professional work within a company. My contribution varied by project and included design, implementation, development, maintenance, content, support and ongoing digital assistance.',

    view: 'View website',

    projects: [
      {
        name: 'Mago Eikim',
        type: 'Web migration',
        contribution: 'Primary implementation',
        description:
          'Complete rebuild of an existing website, migrating it from WordPress to Astro.',
