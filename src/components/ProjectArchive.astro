const t = content[locale];

const archiveCount =
  String(t.projects.length).padStart(2, '0');
---

<section
  id="archive"
  class="archive-section grid-12"
  aria-labelledby="archive-title"
>
  <!-- =====================================
       INTRO
  ====================================== -->

  <header class="archive-intro">
    <p class="metadata archive-intro__eyebrow">
      {t.eyebrow}
    </p>

    <div class="archive-intro__content">
      <h2 id="archive-title">
        <span>
          {t.title}
        </span>

        <em>
          {t.accent}
        </em>
      </h2>

      <p class="archive-intro__description">
        {t.description}
      </p>
    </div>
  </header>

  <!-- =====================================
       FRAME
  ====================================== -->

  <div class="archive-frame">

    <!-- ==================================
         OPTIMIZED ATMOSPHERE
    =================================== -->

    <div
      class="archive-atmosphere"
      aria-hidden="true"
    >
      <svg
        class="archive-orbits"
        viewBox="0 0 1200 760"
        preserveAspectRatio="none"
        focusable="false"
      >
        <ellipse
          class="archive-orbit archive-orbit--01"
          cx="600"
          cy="370"
          rx="555"
          ry="230"
          transform="rotate(-8 600 370)"
        />

        <ellipse
          class="archive-orbit archive-orbit--02"
          cx="760"
          cy="355"
          rx="385"
          ry="305"
          transform="rotate(12 760 355)"
        />

        <ellipse
          class="archive-orbit archive-orbit--03"
          cx="420"
          cy="430"
          rx="310"
          ry="155"
          transform="rotate(-15 420 430)"
        />

        <g class="archive-stars">
          <circle cx="95" cy="315" r="2.5" />
          <circle cx="180" cy="590" r="2" />
          <circle cx="330" cy="135" r="2.5" />
          <circle cx="510" cy="650" r="3" />
          <circle cx="710" cy="110" r="2" />
          <circle cx="890" cy="620" r="2.5" />
          <circle cx="1050" cy="220" r="3" />
          <circle cx="1120" cy="520" r="2" />
        </g>

        <g class="archive-network">
          <path d="M95 315L330 135L710 110" />
          <path d="M180 590L510 650L890 620L1120 520" />
          <path d="M330 135L510 650" />
          <path d="M710 110L1050 220L1120 520" />
        </g>
      </svg>
    </div>

    <!-- ==================================
         FRAME HEADER
    =================================== -->

    <header class="archive-frame__header">
      <span class="metadata">
        {t.frameLabel}
      </span>

      <div class="archive-frame__header-right">
        <span class="archive-frame__status">
          <span aria-hidden="true"></span>

          {t.collaboration}
        </span>

        <span class="archive-frame__scroll metadata">
          {t.scrollLabel}
        </span>

        <span class="metadata">
          {archiveCount}
        </span>
      </div>
    </header>

    <!-- ==================================
         NOTE
    =================================== -->

    <aside class="archive-note">
      <span
        class="archive-note__icon"
        aria-hidden="true"
      >
        i
      </span>

      <div>
        <strong>
          {t.noteTitle}
        </strong>

        <p>
          {t.note}
        </p>
      </div>
    </aside>

    <!-- ==================================
         SCROLLABLE LIST
    =================================== -->

    <div
      class="archive-list"
      tabindex="0"
      aria-label={t.listLabel}
    >
      {
        t.projects.map((project, index) => (
          <article
            class:list={[
              'archive-row',
              `archive-row--${project.tone}`,
            ]}
          >
            <!-- visual -->

            <div
              class="archive-row__visual"
              aria-hidden="true"
            >
              <span class="archive-row__number">
                {String(index + 1).padStart(2, '0')}
              </span>

              <div class="archive-row__mini">
                <span></span>
                <span></span>
                <span></span>

                <i></i>
              </div>
            </div>

            <!-- project -->

            <div class="archive-row__project">
              <span class="metadata">
                {project.type}
              </span>

              <h3>
                {project.name}
              </h3>

              <p>
                {project.description}
              </p>
            </div>

            <!-- contribution -->

            <div class="archive-row__contribution">
              <span class="archive-row__badge">
                {t.collaboration}
              </span>

              <strong>
                {project.contribution}
              </strong>
            </div>

            <!-- tags -->

            <ul
              class="archive-row__tags"
              aria-label="Technologies"
            >
              {
                project.tags.map((tag) => (
                  <li>
                    {tag}
                  </li>
                ))
              }
            </ul>

            <!-- link -->

            <div class="archive-row__action">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${t.view}: ${project.name}`}
              >
                <span>
                  {t.view}
                </span>

                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7M9 7h8v8" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- ==================================
         FOOTER
    =================================== -->

    <footer class="archive-frame__footer">
      <span class="metadata">
        DG / 2025—2026
      </span>

      <span class="archive-frame__line"></span>

      <span class="metadata">
        {t.collaboration}
      </span>
    </footer>
  </div>
</section>

<style>
  /* =====================================================
     PERFORMANCE BOUNDARY
  ===================================================== */

  .archive-section {
    position: relative;

    padding-block:
      clamp(6rem, 10vw, 10rem);

    scroll-margin-block-start:
      var(--header-clearance, 7rem);

    /*
     * El navegador puede saltarse pintura/layout
     * cuando esta sección está lejos del viewport.
     */
    content-visibility:
      auto;

    contain-intrinsic-size:
      auto 900px;
  }

  /* =====================================================
     INTRO
  ===================================================== */

  .archive-intro {
    grid-column:
      2 / 12;

    display: grid;

    grid-template-columns:
      minmax(8rem, .3fr)
      minmax(0, 1fr);

    gap:
      clamp(2rem, 5vw, 5rem);

    align-items: start;

    margin-block-end:
      clamp(2.5rem, 5vw, 4.5rem);
  }

  .archive-intro__eyebrow {
    margin: 0;

    color:
      var(--color-text-muted);
  }

  .archive-intro h2 {
    display: flex;

    flex-direction: column;

    max-inline-size: 15ch;

    margin: 0;

    color:
      var(--color-text);

    font-family:
      var(--font-body);

    font-size:
      clamp(3rem, 5vw, 5.8rem);

    font-weight:
      var(--weight-medium);

    line-height: .94;

    letter-spacing:
      -.055em;
  }

  .archive-intro h2 em {
    color:
      var(--color-link);

    font-family:
      var(--font-display);

    font-weight:
      var(--weight-normal);

    font-style:
      italic;
  }

  .archive-intro__description {
    max-inline-size: 56ch;

    margin:
      1.7rem 0 0;

    color:
      var(--color-text-muted);

    font-size:
      clamp(1.05rem, 1.25vw, 1.16rem);

    line-height:
      1.72;
  }

  /* =====================================================
     FRAME
  ===================================================== */

  .archive-frame {
    grid-column:
      2 / 12;

    position: relative;

    display: grid;

    grid-template-rows:
      auto
      auto
      minmax(0, 1fr)
      auto;

    block-size:
      clamp(42rem, 78vh, 52rem);

    overflow: hidden;

    isolation: isolate;

    contain:
      layout paint style;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-link) 18%,
        transparent
      );

    border-radius:
      clamp(1rem, 2vw, 1.4rem);

    /*
     * Las "luces" ahora son gradientes.
     *
     * Visualmente tenemos los mismos orbes,
     * pero NO existe ningún filter: blur().
     */
    background:
      radial-gradient(
        circle at 92% 2%,
        rgb(170 153 255 / .18),
        transparent 28%
      ),

      radial-gradient(
        circle at 4% 58%,
        rgb(239 167 215 / .11),
        transparent 28%
      ),

      radial-gradient(
        circle at 76% 98%,
        rgb(139 183 255 / .12),
        transparent 30%
      ),

      linear-gradient(
        145deg,
        color-mix(
          in srgb,
          var(--color-link) 4%,
          transparent
        ),
        transparent 42%
      ),

      color-mix(
        in srgb,
        var(--color-surface) 97%,
        var(--color-bg)
      );

    box-shadow:
      0 2rem 6rem
      color-mix(
        in srgb,
        var(--color-bg) 26%,
        transparent
      );

    /*
     * Importante:
     * NO backdrop-filter aquí.
     */
  }

  /* =====================================================
     ATMOSPHERE
  ===================================================== */

  .archive-atmosphere {
    position: absolute;

    z-index: 0;

    inset: 0;

    overflow: hidden;

    pointer-events: none;
  }

  .archive-orbits {
    position: absolute;

    inset: 0;

    inline-size:
      100%;

    block-size:
      100%;

    color:
      var(--color-link);

    opacity: .21;
  }

  .archive-orbit {
    fill: none;

    stroke:
      currentColor;

    stroke-width:
      1;

    vector-effect:
      non-scaling-stroke;
  }

  .archive-orbit--01 {
    stroke-dasharray:
      10 16;
  }

  .archive-orbit--02 {
    stroke-dasharray:
      3 14;

    opacity: .7;
  }

  .archive-orbit--03 {
    /*
     * Esta órbita queda estática.
     * Sigue enriqueciendo la escena sin
     * sumar otra animación continua.
     */
    stroke-dasharray:
      1 11;

    opacity: .42;
  }

  .archive-network {
    fill: none;

    stroke:
      currentColor;

    stroke-width:
      .65;

    opacity:
      .12;

    vector-effect:
      non-scaling-stroke;
  }

  .archive-stars {
    fill:
      currentColor;

    opacity: .64;
  }

  /* =====================================================
     FOREGROUND
  ===================================================== */

  .archive-frame__header,
  .archive-note,
  .archive-list,
  .archive-frame__footer {
    position: relative;

    z-index: 2;
  }

  /* =====================================================
     HEADER
  ===================================================== */

  .archive-frame__header {
    display: flex;

    justify-content:
      space-between;

    align-items:
      center;

    gap: 1rem;

    padding:
      1.05rem
      1.4rem;

    border-block-end:
      var(--border-subtle);

    /*
     * Fondo suficiente para separar,
     * pero sin backdrop-filter.
     */
    background:
      color-mix(
        in srgb,
        var(--color-surface) 94%,
        transparent
      );

    color:
      var(--color-text-muted);
  }

  .archive-frame__header-right {
    display: flex;

    align-items:
      center;

    gap:
      clamp(1rem, 2vw, 1.8rem);
  }

  .archive-frame__status {
    display: flex;

    align-items:
      center;

    gap: .55rem;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      clamp(.68rem, .75vw, .78rem);

    letter-spacing:
      .07em;
  }

  .archive-frame__status > span {
    inline-size:
      .45rem;

    block-size:
      .45rem;

    flex: none;

    border-radius: 50%;

    background:
      var(--color-link);

    box-shadow:
      0 0 .65rem
      color-mix(
        in srgb,
        var(--color-link) 45%,
        transparent
      );
  }

  .archive-frame__scroll {
    color:
      var(--color-link);

    font-size:
      clamp(.68rem, .75vw, .78rem);
  }

  /* =====================================================
     NOTE
  ===================================================== */

  .archive-note {
    display: grid;

    grid-template-columns:
      auto
      minmax(0, 1fr);

    gap:
      1rem;

    align-items:
      start;

    padding:
      1.2rem
      1.4rem;

    border-block-end:
      var(--border-subtle);

    background:
      color-mix(
        in srgb,
        var(--color-link) 5%,
        var(--color-surface)
      );
  }

  .archive-note__icon {
    inline-size:
      1.9rem;

    block-size:
      1.9rem;

    display: grid;

    place-items: center;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--color-link) 40%,
        transparent
      );

    border-radius:
      50%;

    color:
      var(--color-link);

    font-family:
      var(--font-display);

    font-size:
      1.05rem;

    font-style:
      italic;
  }

  .archive-note strong {
    color:
      var(--color-text);

    font-size:
      clamp(.96rem, 1vw, 1.06rem);

    font-weight:
      var(--weight-medium);
  }

  .archive-note p {
    max-inline-size:
      80ch;

    margin:
      .45rem 0 0;

    color:
      var(--color-text-muted);

    font-size:
      clamp(.86rem, .92vw, .96rem);

    line-height:
      1.62;
  }

  /* =====================================================
     SCROLL
  ===================================================== */

  .archive-list {
    min-block-size: 0;

    overflow-y:
      auto;

    overflow-x:
      hidden;

    scrollbar-gutter:
      stable;

    /*
     * Evita bloquear la página al llegar
     * al final del listado.
     */
    overscroll-behavior-y:
      auto;

    outline: none;

    /*
     * Esta parte es importante:
     * aislamos la pintura del contenido
     * que se desplaza.
     */
    contain:
      layout paint style;

    scrollbar-width:
      thin;

